---
// Mono uppercase tag chips. Decorative, non-interactive (design-spec.md S7 Tag).
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-row">
      {tags.map((tag) => (
        <li class="tag text-label">{tag}</li>
      ))}
    </ul>
  )
}

<style>
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: var(--space-2);
  }

  .tag {
    color: var(--fg-muted);
    background: var(--surface-1);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-1);
    padding: var(--space-1) var(--space-2);
  }
</style>
