---
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';
---

<Base title="404 — Svetlin Galov" description="That page isn't here." noindex>
  <div class="container not-found">
    <h1 class="text-display-l">404</h1>
    <p class="text-body-l copy">
      That page isn't here. Try <a href={href('/')}>Home</a> or <a href={href('/about/')}>About</a>.
    </p>
  </div>
</Base>

<style>
  .not-found {
    max-width: var(--measure-narrow);
    margin-inline: auto;
    padding-block: var(--space-10);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
  }

  .not-found h1 {
    color: var(--fg);
  }

  .copy {
    color: var(--fg-muted);
  }

  .copy a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }

  .copy a:hover {
    color: var(--accent-strong);
    text-decoration-thickness: 2px;
  }
</style>
