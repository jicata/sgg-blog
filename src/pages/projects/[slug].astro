---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagRow from '../../components/TagRow.astro';
import { getProjects } from '../../lib/content';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const isCaseStudy = project.data.featured;
---

<Base
  title={`${project.data.title} — Svetlin Galov`}
  description={project.data.summary}
  ogType="article"
  canonical={new URL(href(`/projects/${project.id}/`), Astro.site).toString()}
>
  <div class="container">
    <article class="project-article">
      {
        isCaseStudy ? (
          <header class="case-study-header">
            <p class="text-label eyebrow">CASE STUDY · AGENTIC ENGINEERING</p>
            <h1 class="text-display-l">{project.data.title}</h1>
            <p class="text-body-l dek">{project.data.summary}</p>
            <TagRow tags={project.data.tags} />
          </header>
        ) : (
          <header class="job-header">
            <h1 class="text-h1">{project.data.title}</h1>
            <p class="text-ui company">{project.data.role}</p>
            <p class="text-label dates">{project.data.dates}</p>
            <p class="text-body context">{project.data.summary}</p>
          </header>
        )
      }

      <div class="prose prose-width project-body">
        <Content />
      </div>
    </article>
  </div>
</Base>

<style>
  .project-article {
    padding-block: var(--space-8) var(--space-9);
  }

  .case-study-header {
    max-width: var(--prose);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-9);
  }

  .eyebrow {
    color: var(--accent);
  }

  .case-study-header h1 {
    color: var(--fg);
  }

  .dek {
    color: var(--fg-muted);
  }

  .job-header {
    max-width: var(--prose);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .job-header h1 {
    color: var(--fg);
  }

  .company {
    color: var(--fg-muted);
  }

  .dates {
    color: var(--fg-dim);
  }

  .context {
    color: var(--fg-muted);
    margin-top: var(--space-2);
  }
</style>
